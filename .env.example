# Copia este archivo como .env y rellena tus valores. NO subas el .env.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
MELCOCHITA_VOICE_ID=nd89Nw4NE33rXRB5xGQe
ELEVEN_MODEL_ID=eleven_multilingual_v2
LIMITE_POR_IP_DIA=40
# Motor v3: probabilidad (0-1) de devolver una chapa ORIGINAL del corpus.
PROBABILIDAD_CHAPA_ORIGINAL=0.30
# Voz: por defecto la chapa se sintetiza SIN marco porque el "Mi querido…"
# lo dan los intros pregrabados (frases-intro-chapa/). Pon true para volver
# al marco sintetizado y no usar intros grabados.
VOZ_CON_MARCO=false
# Caché externo persistente (Upstash Redis, tier gratis). Sin estas vars, la
# caché de audios vive solo en el disco (efímero en Render free). Con ellas,
# los MP3 sobreviven redeploys y "sleeps", y no se re-gastan créditos por
# chapas repetidas. Cópialas del panel de Upstash -> tu base -> "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: días para expirar cada audio en Redis (0 = sin expirar).
VOZ_CACHE_TTL_DIAS=0
